{
  "name": "miniprojectplaywright2026",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:e2e": "playwright test tests/E2E --config=Config/e2e.config.ts --project=Chromium ",
    "tests:login": "playwright test tests/E2E/e2e-login.spec.ts --config=Config/e2e.config.ts --project=Chromium --headed",
    "tests:transfer": "playwright test tests/E2E/e2e-Transfer.spec.ts --config=Config/e2e.config.ts --project=Chromium --headed",
    "tests:billpay": "playwright test tests/E2E/e2e-PayBill.spec.ts --config=Config/e2e.config.ts --project=Chromium --headed",
    "clean:report": "rimraf allure-report allure-results && mkdirp allure-report allure-results",
    "report:generate": "npx allure generate ./allure-results --clean -o ./allure-report",
    "report:open": "npx allure open ./allure-report",
    "test:report": "npm run clean:report && npm run test:e2e ||  npm run report:generate && npm run report:open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0"
  },
  "dependencies": {
    "allure-commandline": "^2.43.0",
    "allure-js-commons": "^3.11.0",
    "allure-playwright": "^3.11.0",
    "mkdirp": "^3.0.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3"
  }
}
